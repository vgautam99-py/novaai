# Server Configuration
PORT=5000
NODE_ENV=development

# Database Setup
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/novaai

# JWT Security secrets
JWT_ACCESS_SECRET=your_32_character_jwt_access_secret_here
JWT_REFRESH_SECRET=your_32_character_jwt_refresh_secret_here

# Google Gemini API
GEMINI_API_KEY=AIzaSy...

# Cloudinary CDN Config
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mailjet Email Keys (replace with your active API keys)
MAILJET_API_KEY_PUBLIC=your_mailjet_public_key
MAILJET_API_KEY_PRIVATE=your_mailjet_private_key
SENDER_EMAIL=support@novaai.com

# Razorpay payments integrations (optional in Dev mode; will emulate mocks if blank)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
